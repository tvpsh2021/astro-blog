---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "./Pagination.astro";
import PostTimeline from "./PostTimeline.astro";
import type { Post } from "../lib/wordpress";

interface Props {
  posts: Post[];
  currentPage: number;
  totalPages: number;
  totalPosts: number;
}

const { posts, currentPage, totalPages, totalPosts } = Astro.props;
const pageTitle = currentPage === 1 ? "所有文章 | 淺草先生" : `所有文章，第 ${currentPage} 頁 | 淺草先生`;
---

<BaseLayout title={pageTitle} description="依年份瀏覽淺草先生的所有文章。">
  <section class="page-intro">
    <h1>所有文章</h1>
    <p>共 {totalPosts} 篇，從新到舊排列。</p>
  </section>
  <div class="page-body">
    <PostTimeline posts={posts} />
    <Pagination basePath="/archive/" currentPage={currentPage} totalPages={totalPages} />
  </div>
</BaseLayout>
