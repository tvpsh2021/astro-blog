---
interface Props {
  basePath: string;
  currentPage: number;
  totalPages: number;
}

const { basePath, currentPage, totalPages } = Astro.props;
const pageUrl = (page: number) => page === 1 ? basePath : `${basePath}page/${page}/`;
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="文章分頁">
    {currentPage > 1 ? (
      <a class="pagination-step" href={pageUrl(currentPage - 1)} rel="prev">← 上一頁</a>
    ) : <span class="pagination-step pagination-disabled">← 上一頁</span>}
    <div class="pagination-pages">
      {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
        <a href={pageUrl(page)} aria-label={`第 ${page} 頁`} aria-current={page === currentPage ? "page" : undefined}>
          {page}
        </a>
      ))}
    </div>
    {currentPage < totalPages ? (
      <a class="pagination-step" href={pageUrl(currentPage + 1)} rel="next">下一頁 →</a>
    ) : <span class="pagination-step pagination-disabled">下一頁 →</span>}
  </nav>
)}
