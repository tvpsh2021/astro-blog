---
import { monthDay } from "../lib/timeline";
import type { Post } from "../lib/wordpress";

interface Props {
  post: Post;
  showExcerpt?: boolean;
}

const { post, showExcerpt = false } = Astro.props;
---

<li class="entry">
  <div class="entry-meta">
    <time class="entry-date" datetime={post.date}>{monthDay(post)}</time>
    {showExcerpt && post.categories[0] && <a class="entry-category" href={post.categories[0].path}>{post.categories[0].name}</a>}
  </div>
  <div class="entry-body">
    <h3 class="entry-title"><a href={post.path}>{post.title}</a></h3>
    {showExcerpt && post.excerpt && <p class="entry-excerpt">{post.excerpt}</p>}
  </div>
</li>
