---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActivityGrid from "./ActivityGrid.astro";
import Pagination from "./Pagination.astro";
import PostTimeline from "./PostTimeline.astro";
import type { Post } from "../lib/wordpress";

interface Props {
  posts: Post[];
  currentPage: number;
  totalPages: number;
  totalPosts: number;
  /** Every post, newest first. Only the first page passes it, to draw the activity grid. */
  allPosts?: Post[];
}

const { posts, currentPage, totalPages, totalPosts, allPosts } = Astro.props;
const pageTitle = currentPage === 1 ? "淺草先生 | 忙碌人生" : `第 ${currentPage} 頁 | 淺草先生`;
---

<BaseLayout title={pageTitle} description="淺草先生的技術與生活筆記。">
  <section class="page-intro">
    {allPosts ? (
      <>
        <h1 class="visually-hidden">淺草先生</h1>
        <ActivityGrid posts={allPosts} />
      </>
    ) : (
      <h1>文章，第 {currentPage} 頁</h1>
    )}
  </section>
  <div class="page-body">
    <PostTimeline posts={posts} showExcerpt />
    <Pagination basePath="/" currentPage={currentPage} totalPages={totalPages} />
    <a class="all-posts-link" href="/archive/">依年份瀏覽全部 {totalPosts} 篇</a>
  </div>
</BaseLayout>
