---
import PostCard from "./PostCard.astro";
import { groupByYear } from "../lib/timeline";
import type { Post } from "../lib/wordpress";

interface Props {
  posts: Post[];
  showExcerpt?: boolean;
}

const { posts, showExcerpt = false } = Astro.props;
---

<div class:list={["timeline", { "timeline-compact": !showExcerpt }]}>
  {groupByYear(posts).map(({ year, posts: yearPosts }) => (
    <section class="year-group" id={`y${year}`} aria-labelledby={`y${year}-title`}>
      <h2 class="year-title" id={`y${year}-title`}>{year}</h2>
      <ol class="entries">
        {yearPosts.map((post) => <PostCard post={post} showExcerpt={showExcerpt} />)}
      </ol>
    </section>
  ))}
</div>
