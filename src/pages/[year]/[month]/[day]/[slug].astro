---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { archiveYearHref, fullDate } from "../../../../lib/timeline";
import { getPosts, type Post } from "../../../../lib/wordpress";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { year: post.year, month: post.month, day: post.day, slug: post.slug },
    props: { post, yearHref: archiveYearHref(posts.findIndex(({ year }) => year === post.year), post.year) },
  }));
}

interface Props {
  post: Post;
  yearHref: string;
}

const { post, yearHref } = Astro.props;
---

<BaseLayout title={`${post.title} | 淺草先生`} description={post.excerpt || post.title} canonicalPath={post.path} image={post.featuredImage?.source_url} ogType="article">
  <article class="article-page">
    <header class="article-header">
      <div class="article-meta">
        <time datetime={post.date}>{fullDate(post)}</time>
        {post.categories.map((category) => <a href={category.path}>{category.name}</a>)}
      </div>
      <h1>{post.title}</h1>
    </header>
    <div class="article-content" set:html={post.content} />
    {post.tags.length > 0 && (
      <div class="article-tags" aria-label="文章標籤">
        {post.tags.map((tag) => <a href={tag.path}>#{tag.name}</a>)}
      </div>
    )}
    <footer class="article-footer">
      <a href={yearHref}>{post.year} 年的其他文章</a>
    </footer>
  </article>
</BaseLayout>
