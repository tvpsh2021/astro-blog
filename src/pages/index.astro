---
import HomeListing from "../components/HomeListing.astro";
import { HOME_PAGE_SIZE, pageCount, pageItems } from "../lib/pagination";
import { getPosts } from "../lib/wordpress";

const posts = await getPosts();
const totalPages = pageCount(posts.length, HOME_PAGE_SIZE);
---

<HomeListing posts={pageItems(posts, 1, HOME_PAGE_SIZE)} currentPage={1} totalPages={totalPages} totalPosts={posts.length} />
